{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:3329"
      }
    }
  },
  "ServerSettings": {
    "ApiBasePath": "/api-game",
    "AssetStorageRoot": "c:/NDLWebServerBuild/wwwroot/glb_storage",
    "PublicBaseUrl": "https://renderfin.com",
    "Cors": {
      "AllowedOrigins": [
        "https://renderfin.com"
      ],
      "AllowedMethods": [
        "GET",
        "POST",
        "PUT",
        "DELETE"
      ],
      "AllowedHeaders": [
        "Content-Type",
        "Authorization"
      ]
    },
    "AssetIndex": {
      "FormatVersion": 0,
      "RebuildOnStart": true
    }
  },
  "ConnectionStrings": {
    "Default": "Data Source=gameserver.db"
  }
}
